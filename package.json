{
  "name": "hackerpdf",
  "private": true,
  "version": "1.0.0",
  "description": "Private, in-browser PDF tools: redact, merge, split, rotate, number pages, convert to text or Markdown, and turn images into PDFs.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
