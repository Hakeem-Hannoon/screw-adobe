{
  "name": "hackerpdf",
  "private": true,
  "version": "1.0.0",
  "description": "Private, in-browser PDF tools: redact, sign, merge, split, rotate, number pages, convert between PDF and Word, to text or Markdown, and between PDFs and images.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ios:sync": "npm run build && cap sync ios"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/alex-brush": "^5.3.0",
    "@fontsource/ballet": "^5.3.0",
    "@fontsource/cedarville-cursive": "^5.3.0",
    "@fontsource/dawning-of-a-new-day": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/herr-von-muellerhoff": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/imperial-script": "^5.3.0",
    "@fontsource/italianno": "^5.3.0",
    "@fontsource/kristi": "^5.3.0",
    "@fontsource/la-belle-aurore": "^5.3.0",
    "@fontsource/mea-culpa": "^5.3.0",
    "@fontsource/monsieur-la-doulaise": "^5.3.0",
    "@fontsource/mr-de-haviland": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@fontsource/ms-madi": "^5.3.0",
    "@fontsource/nothing-you-could-do": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/waiting-for-the-sunrise": "^5.3.0",
    "@fontsource/zeyada": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx-preview": "^0.4.1",
    "jszip": "^3.10.2",
    "marked": "^18.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
